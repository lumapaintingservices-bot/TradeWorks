# Firebase project for TradeWorks (create a NEW project, e.g. tradeworks-app). Leave empty to run in local demo mode.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Billing (Stripe). Empty = billing off. Set to /api/billing after deploying the Cloudflare functions (see docs/08-billing-setup.md)
VITE_BILLING_API=
# Calendar feed worker URL (see workers/README.md)
VITE_CAL_FEED_URL=
