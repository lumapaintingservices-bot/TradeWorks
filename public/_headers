# Cloudflare Pages response headers (copied into the build output). Docs: https://developers.cloudflare.com/pages/configuration/headers/
# Every page, including the public client link (/p/...) and the lead form (/request): nobody may frame them (clickjacking),
# scripts only from this site, network calls only to this site and the Google / Firebase APIs the app uses.
# Team map: map tiles and address lookups from OpenStreetMap; the phone's location only for this site (workers' clock-in).
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://apis.google.com; style-src 'self' https://fonts.googleapis.com; style-src-attr 'unsafe-inline'; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https://lh3.googleusercontent.com https://firebasestorage.googleapis.com https://storage.googleapis.com https://tile.openstreetmap.org; connect-src 'self' https://nominatim.openstreetmap.org https://apis.google.com https://firestore.googleapis.com https://firebasestorage.googleapis.com https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://www.googleapis.com https://*.firebaseio.com wss://*.firebaseio.com; frame-src https://*.firebaseapp.com https://accounts.google.com; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; worker-src 'self' blob:; manifest-src 'self'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), microphone=(), geolocation=(self), payment=(), usb=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000
  Cross-Origin-Opener-Policy: same-origin-allow-popups

# Built files have a hash in their name: cache them for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
